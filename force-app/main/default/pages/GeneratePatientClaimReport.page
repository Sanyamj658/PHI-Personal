<apex:page controller="GeneratePatientClaimReportController"  readOnly="True" lightningStylesheets="true" docType="html-5.0">
    <head>
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.0/umd/popper.min.js"></script>
        <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.0/js/bootstrap.min.js"></script>
    </head>
        <script>
            function checkErrorMessage(hasError){
            if(hasError){
                return;
            }else{
                afterExportReport();
            }
        }
        </script>
        
        <apex:form id="formId">
            <apex:pageMessages />
            <apex:actionStatus id="actionStatusID">
                <apex:facet name="start">
                    <div class="slds-spinner_container" style="position: fixed;" >
                        <div role="status" class="slds-spinner slds-spinner--large slds-spinner--brand">
                            <div class="slds-spinner__dot-a"></div>
                            <div class="slds-spinner__dot-b"></div>
                        </div>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <apex:actionFunction action="{!afterExportReport}" name="afterExportReport" reRender="pageId,formId"/>
            <apex:pageBlock id="pageBlockId" title="Patient Claim Report">
                <apex:pageBlockSection id="calculationVariables" columns="1">
                    
                    <apex:pageBlockSection title="Activity Due Date" columns="2" >
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="From Date" for="From Date" />
                            <apex:input type="date" value="{!fromdate}"/>
                        </apex:pageBlockSectionItem>
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="To Date" for="To Date" />
                            <apex:input type="date" value="{!todate}"/>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection title="Advance search filter" columns="2">
                        <apex:pageBlockSectionItem >
                            <!-- <apex:inputField value="{!objClaim.Collector__c}"/> -->
                            <apex:outputLabel value="Collector"/>
                            
                            <apex:selectList size="7" value="{!Collector}" multiselect="true">
                                <apex:selectOptions value="{!Collectors}" />
                            </apex:selectList>
                        </apex:pageBlockSectionItem>
                        <apex:pageBlockSectionItem >
                            <!-- <apex:inputField value="{!objClaim.Collector__c}"/> -->
                            <apex:outputLabel value="Medical Provider"/>
                            <apex:selectList size="7" value="{!medProvider}" multiselect="true">
                                <apex:selectOptions value="{!MetdicalProvider}"/>
                            </apex:selectList>
                        </apex:pageBlockSectionItem>
                        <!--<apex:inputField required="false" value="{!objClaim.Medical_Provider__c}"/>-->
                    </apex:pageBlockSection>
                </apex:pageBlockSection>
                <apex:pageBlockButtons >
                    <apex:commandButton action="{!showReport}" value="Export Report" oncomplete="checkErrorMessage({!hasError});" status="actionStatusID" rerender="pageId,pageBlockId"/>
                </apex:pageBlockButtons>
            </apex:pageBlock>
        </apex:form>
    </apex:page>